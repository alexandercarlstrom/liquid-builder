{
  "name": "liquid-builder-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LiquidJS template builder with Vue 3",
  "scripts": {
    "dev": "npm run dev --workspace=playground",
    "build": "npm run build --workspace=liquid-builder",
    "build:all": "npm run build --workspaces --if-present",
    "playground": "npm run dev --workspace=playground",
    "lib": "npm run dev --workspace=liquid-builder"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
